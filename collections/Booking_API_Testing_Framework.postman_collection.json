          "name": "POST_Create_Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking created successfully\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking ID is generated\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response).to.have.property(\"bookingid\");\r",
                  "    pm.expect(response.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Customer details match request\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.booking.firstname).to.eql(\"Divya\");\r",
                  "    pm.expect(response.booking.lastname).to.eql(\"QA\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking amount is correct\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.booking.totalprice).to.eql(1500);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking dates are correct\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.booking.bookingdates.checkin)\r",
                  "        .to.eql(\"2026-12-01\");\r",
                  "\r",
                  "    pm.expect(response.booking.bookingdates.checkout)\r",
                  "        .to.eql(\"2026-12-05\");\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.collectionVariables.set(\"bookingId\", jsonData.bookingid.toString());\r",
                  "\r",
                  "console.log(\"Created booking ID:\", jsonData.bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
